### Os valores podem ser mudados conforme necessidade ###

# ==========================================
# Configurações Gerais e de Arquivos
# ==========================================

# Tamanho da senha gerada
PASSWORD_LENGTH=8
# Índice de início do usuário no sistema (ex: 1001)
START_INDEX=1001
# Nome da turma associada a estes usuários (ex: Turma A, 3º Ano, etc.)
USER_CLASS=Turma 1
# Nome do arquivo de entrada (se omitir a extensão, o script assume .txt)
INPUT_FILE=users.txt
# Nome da pasta de saída onde os arquivos serão salvos
OUTPUT_DIR=output
# Nome do arquivo de saída com a configuração para o BOCA
OUTPUT_TXT=boca_users.txt
# Nome do arquivo de saída em CSV para as credenciais dos usuários
OUTPUT_CSV_CREDENTIALS=credenciais
# Nome do arquivo de saída em CSV para a lista de presença
OUTPUT_CSV_ATTENDANCE=lista_presenca

# ==========================================
# Configurações Específicas do Usuário (BOCA)
# ==========================================

# Número do site no BOCA (deve ser um número inteiro)
BOCA_SITE_NUMBER=1
# Tipo do usuário (Opções obrigatórias: team | staff | score | judge | admin | site)
BOCA_USER_TYPE=team
# Permite o usuário logar em múltiplas máquinas ao mesmo tempo (Opções: t | f)
BOCA_MULTI_LOGIN=t
# Define se o usuário já começa habilitado no sistema (Opções: t | f)
BOCA_USER_ENABLED=t
# Define se o usuário pode alterar a própria senha (Opções: t | f)
BOCA_CHANGE_PASSWORD=f