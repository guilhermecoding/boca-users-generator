### Os valores podem mudados conforme necessidade ###

# Tamanho da senha
PASSWORD_LENGTH=8
# Índice de inicio do usuário no sistema
START_INDEX=1001
# Nome do arquivo de entrada
INPUT_FILE=users.txt
# Nome da pasta de saída
OUTPUT_DIR=output
# Nome do arquivo de saída dos usuários do BOCA (este é o que será usado)
OUTPUT_TXT=boca_users.txt
# Nome do arquivo de saída para as credenciais dos usuários
OUTPUT_CSV_CREDENTIALS=credenciais
# Nome do arquivo de saída para o credenciamento dos usuários
OUTPUT_CSV_ATTENDANCE=lista_presenca